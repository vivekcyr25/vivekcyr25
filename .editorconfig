# EditorConfig - consistent coding styles across editors
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.svg]
indent_size = 2
insert_final_newline = false

[*.json]
indent_size = 2

[*.toml]
indent_size = 4

[Makefile]
indent_style = tab